# Single source of truth for pinned build inputs.
# Sourced by build.sh / package.sh / bench.sh. Changing any of these is a
# build-input change; bump ARTIFACT_CONTRACT_VERSION if it alters the output shape.

# Build image (compiler baseline) = AL2023 aarch64. This is RESOLVED-and-RECORDED build
# provenance, NOT a runtime pin: LTEmbed deploys on AWS-managed AL2023 (Lambda/Fargate)
# whose patch level AWS controls, and consumers pin the ARTIFACT checksum, not this image.
# CI resolves the current AL2023 digest at build time, records it in build-info.json, and
# gates the observed environment against the envelope below.
#
# AL2023_DIGEST is an OPTIONAL override: set it to a sha256:... to force a reproducible
# build against a specific patch level; leave empty to resolve the current tag in CI.
AL2023_DIGEST="${AL2023_DIGEST:-}"

# Compiler: Clang 18 (AL2023 `clang18` package). libclang from the same package also
# drives bindgen. C++ stdlib is GNU libstdc++ (clang uses it on Linux), matching the
# AL2023 runtime. Set as CC/CXX in the Dockerfile; overridable for local runs.
CC="${CC:-clang-18}"
CXX="${CXX:-clang++-18}"

# Supported build-environment envelope. CI/build.sh fail if the resolved AL2023 image
# drifts outside this (e.g. AWS bumps clang to a new major that could change codegen/ABI).
EXPECTED_CLANG_MAJOR="18"
MIN_GLIBC="2.34"

# llama-cpp-rs (utilityai) pinned tag. The vendored llama.cpp submodule commit is
# whatever this tag references (resolved + recorded at build time).
CRATE_REPO="https://github.com/utilityai/llama-cpp-rs"
CRATE_TAG="0.1.151"

# Expected vendored llama.cpp submodule commit for CRATE_TAG (sanity-checked, not trusted).
EXPECTED_LLAMA_CPP_COMMIT="9e3b928fd8c9d14dbf15a8768b9fdd7e5c721d66"

# Target profile. Graviton2 == Neoverse N1 (Armv8.2-A + fp16 + dotprod; NO i8mm/SVE).
# We drive the ISA through ggml's OWN knob (GGML_CPU_ARM_ARCH -> -march) so the CPU
# kernels get dotprod, and add -mtune for N1 scheduling. We deliberately do NOT use
# -mcpu: ggml itself injects a -march on the CPU TUs, and -mcpu=neoverse-n1 alongside
# -march=armv8-a makes GCC take the (older) ISA from -march, silently dropping dotprod.
# Never `native` — the N2 runner would emit N1-illegal instructions.
TARGET_TRIPLE="aarch64-unknown-linux-gnu"
# N1 ISA: dotprod + fp16 + rcpc (FEAT_LRCPC — N1 implements it). All valid -march features
# that emit native code. NOTE: no -flto — clang LTO emits LLVM bitcode objects, which a
# consumer linking the prebuilt .a with GNU ld / rustc's `cc` driver cannot consume (and
# rustc's LLVM version won't match clang 18's bitcode). LTO is incompatible with shipping
# native static archives.
CPU_MARCH="armv8.2-a+fp16+dotprod+rcpc"
CPU_MTUNE="neoverse-n1"
CFLAGS_TUNE="-O3 -march=${CPU_MARCH} -mtune=${CPU_MTUNE}"

# For Linux aarch64 (non-native) the crate hardcodes GGML_CPU_ARM_ARCH="armv8-a", which
# ggml turns into -march=armv8-a (no dotprod) on the CPU kernels. The crate only forwards
# CMAKE_* env vars, so we rewrite that literal in the cloned build.rs to CPU_MARCH.
# Idempotent (once replaced there is no "armv8-a" left); returns non-zero if the expected
# value isn't present afterwards (upstream build.rs changed) so callers can fail loudly.
patch_ggml_arm_arch() {
  local build_rs="$1"
  CPU_MARCH="${CPU_MARCH}" perl -0pi -e \
    's/config\.define\("GGML_CPU_ARM_ARCH", "armv8-a"\)/config.define("GGML_CPU_ARM_ARCH", "$ENV{CPU_MARCH}")/g' \
    "${build_rs}"
  grep -qF "\"${CPU_MARCH}\"" "${build_rs}"
}

# llama-cpp-sys-2 cargo features to enable. No `openmp`: clang would pull LLVM libomp
# (absent on AL2023/Lambda); without the feature the crate sets GGML_OPENMP=OFF and ggml
# uses its built-in pthread threadpool — no libgomp/libomp runtime dependency.
CRATE_FEATURES="common"

# Canonical link ORDER (single source of truth). GNU ld resolves left-to-right, so a
# library must precede the libs it depends on: llama-common -> llama -> ggml ->
# ggml-cpu -> ggml-base. build.sh derives build-info.json's `link_line` from this, and
# scripts/consume.build.rs uses the SAME order. Keep all three in sync.
STATIC_LIBS="libllama-common.a libllama.a libggml.a libggml-cpu.a libggml-base.a"

# System libraries a consumer must add at final link (documented in CONTRACT.md).
# No -lgomp: OpenMP is disabled (ggml threadpool).
SYSTEM_LINK_LIBS="stdc++ pthread m dl"

# Versioned artifact contract. Bump on ANY change to lib set, link line, features,
# binding ABI, or dist/ layout. v2: clang-18 compiler, dropped OpenMP (no -lgomp).
ARTIFACT_CONTRACT_VERSION="2"
