# Single source of truth for pinned build inputs.
# Sourced by build.sh / package.sh / bench.sh / correctness.sh (the build scripts then
# source scripts/lib.sh for the fail-closed helpers that consume these pins). Changing any
# of these is a build-input change; bump ARTIFACT_CONTRACT_VERSION if it alters the output shape.

# Build image (compiler baseline) = AL2023 of the NATIVE host arch (aarch64 or x86_64). This
# is RESOLVED-and-RECORDED build provenance for traceability/debugging, NOT a
# reproducibility pin: LTEmbed deploys on
# AWS-managed AL2023 (Lambda/Fargate) whose patch level AWS controls, and consumers pin the
# ARTIFACT checksum, not this image. CI resolves the current AL2023 digest at build time,
# records it (plus exact compiler/glibc/package versions) in build-info.json, and gates the
# observed environment against the envelope below.
#
# AL2023_DIGEST is an OPTIONAL override: set it to a sha256:... to pin the base image for a
# specific run (aids tracing/repro of an issue). NOTE: this is not a full reproducibility
# guarantee — `dnf update/install` still pulls current packages from mutable repos; the
# exact resolved versions are what get recorded in build-info.json.
AL2023_DIGEST="${AL2023_DIGEST:-}"

# Compiler: Clang 18 (AL2023 `clang18` package). libclang from the same package also
# drives bindgen. C++ stdlib is GNU libstdc++ (clang uses it on Linux), matching the
# AL2023 runtime. Set as CC/CXX in the Dockerfile; overridable for local runs.
CC="${CC:-clang-18}"
CXX="${CXX:-clang++-18}"

# Supported build-environment envelope. CI/build.sh fail if the resolved AL2023 image
# drifts outside this (e.g. AWS bumps clang to a new major that could change codegen/ABI).
EXPECTED_CLANG_MAJOR="18"
MIN_GLIBC="2.34"

# llama.cpp (ggml-org) — the inference engine actually compiled into the archives. Pinned
# by release tag AND commit; scripts/lib.sh prepare_crate_source fails closed unless
# HEAD == EXPECTED_LLAMA_CPP_COMMIT, the annotated tag peels to it, and
# `git describe --tags --exact-match` == LLAMA_CPP_TAG.
LLAMA_CPP_REPO="https://github.com/ggml-org/llama.cpp"
LLAMA_CPP_TAG="v0.6.0"
EXPECTED_LLAMA_CPP_COMMIT="d81235049384534c167caea52b85a694f6103d14"

# llama-cpp-rs (utilityai) — provides llama-cpp-sys-2's build.rs (cmake + bindgen driver).
# No llama-cpp-rs release vendors llama.cpp ${LLAMA_CPP_TAG} (the newest, 0.1.159, vendors
# 26394b4e, 355 commits behind it), so the crate is pinned by tag + commit and its
# llama-cpp-sys-2/llama.cpp gitlink is REPLACED with ${LLAMA_CPP_TAG} at build time. The
# gitlink is still verified so a moved crate tag cannot go unnoticed.
CRATE_REPO="https://github.com/utilityai/llama-cpp-rs"
CRATE_REF="0.1.159"                                                    # git tag (lightweight)
EXPECTED_CRATE_COMMIT="3cfdd729d65e35da407e5f820edf73201bfa54f6"       # what CRATE_REF must resolve to
CRATE_VERSION="0.1.159"                                                # llama-cpp-sys-2 package version at that commit
CRATE_VENDORED_LLAMA_CPP_COMMIT="26394b4e6749a41c3633db040e0987500a5f7013"  # crate's gitlink (overridden)

# --- Target profiles (one per supported architecture) -----------------------------
# Two production variants. Each is compiled ONLY on a native host of its own architecture:
#   actual host arch == container arch == compiler arch == artifact arch.
# Cross compilation (x86 -> ARM, ARM -> x86) and CPU emulation (QEMU, binfmt_misc, buildx
# emulation, cross-rs, cargo-zigbuild, zig, CMake cross toolchains) are not supported.
#
#   Architecture  Target                     CPU baseline                  Tuning
#   ARM64         aarch64-unknown-linux-gnu  armv8.2-a+fp16+dotprod+rcpc   -mtune=neoverse-n1
#   x86-64        x86_64-unknown-linux-gnu   x86-64-v3                     generic (no -mtune)
#
# The profile is chosen by the native host's architecture (below) and every value in it is
# FIXED: nothing is read from the environment and nothing is derived from the build
# machine's CPU (never -march=native / -mtune=native, never an autodetected ISA). The
# baseline is part of the artifact contract, not something a build negotiates: an x86 host
# that is not x86-64-v3 capable is REFUSED (scripts/lib.sh assert_native_host), never served
# a lower -march. There is no x86-64-v2 (or older) variant and no runtime fallback.
SUPPORTED_TARGET_PROFILES="aarch64-graviton2 x86_64-v3"

# set_target_profile <name>: set the profile variables (all unconditionally — an inherited
# CPU_MARCH/CFLAGS_TUNE/... from the environment is overwritten, never honoured):
#   TARGET_PROFILE TARGET_ARCH TARGET_TRIPLE CPU_BASELINE CPU_MARCH CPU_MTUNE CPU_PROFILE
#   CFLAGS_TUNE GGML_ISA_DEFINES ARTIFACT_VARIANT GENERIC_REF_MARCH GENERIC_REF_GGML_DEFINES
set_target_profile() {
  case "$1" in
    aarch64-graviton2)
      # Graviton2 == Neoverse N1 (Armv8.2-A + fp16 + dotprod + rcpc; NO i8mm/SVE). The ISA
      # is driven through ggml's OWN knob (GGML_CPU_ARM_ARCH -> -march) so the CPU kernels
      # get dotprod, plus -mtune for N1 scheduling. Deliberately NOT -mcpu: ggml injects its
      # own -march on the CPU TUs, and -mcpu=neoverse-n1 alongside -march=armv8-a makes the
      # compiler take the (older) ISA from -march, silently dropping dotprod. Never
      # `native` — the N2 CI runner would emit N1-illegal instructions. The crate hardcodes
      # GGML_CPU_ARM_ARCH="armv8-a" for Linux aarch64; scripts/lib.sh patch_ggml_arm_arch
      # rewrites it to CPU_MARCH (exact-count, fail-closed) and build.sh re-checks the
      # value CMake cached.
      TARGET_PROFILE="aarch64-graviton2"
      TARGET_ARCH="aarch64"
      TARGET_TRIPLE="aarch64-unknown-linux-gnu"
      CPU_BASELINE="armv8.2-a+fp16+dotprod+rcpc"
      CPU_MARCH="armv8.2-a+fp16+dotprod+rcpc"
      CPU_MTUNE="neoverse-n1"
      CPU_PROFILE="neoverse-n1"                 # build-info.json cpu_profile
      CFLAGS_TUNE="-O3 -march=${CPU_MARCH} -mtune=${CPU_MTUNE}"
      GGML_ISA_DEFINES=""                       # ISA reaches ggml via GGML_CPU_ARM_ARCH
      ARTIFACT_VARIANT="aarch64-graviton2"      # static-llama-cpp-<tag>-<variant>.tar.gz
      # Correctness reference ONLY (scripts/correctness.sh): never shipped.
      GENERIC_REF_MARCH="armv8-a"
      GENERIC_REF_GGML_DEFINES=""
      ;;
    x86_64-v3)
      # x86-64-v3 (psABI level 3): x86-64-v2 + AVX AVX2 BMI1 BMI2 F16C FMA LZCNT MOVBE
      # (+ OS-enabled AVX state). ISA baseline = x86-64-v3, microarchitecture tuning =
      # compiler generic/default: NO -mtune (no haswell/skylake/znver*), and the gate in
      # build.sh rejects any -mtune, -mcpu, or a -march other than x86-64-v3 on any TU.
      TARGET_PROFILE="x86_64-v3"
      TARGET_ARCH="x86_64"
      TARGET_TRIPLE="x86_64-unknown-linux-gnu"
      CPU_BASELINE="x86-64-v3"
      CPU_MARCH="x86-64-v3"
      CPU_MTUNE=""                              # generic tuning — intentionally empty
      CPU_PROFILE="x86-64-v3"                   # build-info.json cpu_profile
      CFLAGS_TUNE="-O3 -march=${CPU_MARCH}"
      # ggml's x86 ISA options, set EXPLICITLY (never left to ggml's defaults, which flip
      # with SOURCE_DATE_EPOCH / cross detection). ON = exactly the ggml kernels that are
      # inside x86-64-v3; everything above v3 (AVX-VNNI, AVX-512*, AMX*) OFF — ggml selects
      # those at COMPILE time (there is no runtime dispatch without GGML_BACKEND_DL, which is
      # OFF), so enabling any of them would raise the baseline. GGML_NATIVE is forced OFF by
      # the crate (target-cpu=native is refused). Applied only inside scripts/lib.sh
      # build_sys_crate, after assert_no_build_env_overrides; build.sh gates the CMake cache.
      GGML_ISA_DEFINES="GGML_SSE42=ON GGML_AVX=ON GGML_AVX2=ON GGML_BMI2=ON GGML_FMA=ON GGML_F16C=ON GGML_AVX_VNNI=OFF GGML_AVX512=OFF GGML_AVX512_VBMI=OFF GGML_AVX512_VNNI=OFF GGML_AVX512_BF16=OFF GGML_AMX_TILE=OFF GGML_AMX_INT8=OFF GGML_AMX_BF16=OFF"
      ARTIFACT_VARIANT="x86_64-v3-linux-gnu"    # static-llama-cpp-<tag>-<variant>.tar.gz
      # Correctness reference ONLY (scripts/correctness.sh): a generic -march=x86-64 build
      # with every ggml ISA option OFF. It is NOT an artifact, is never published, is not
      # part of the support matrix, and does not mean CPUs below x86-64-v3 are supported.
      GENERIC_REF_MARCH="x86-64"
      GENERIC_REF_GGML_DEFINES="GGML_SSE42=OFF GGML_AVX=OFF GGML_AVX2=OFF GGML_BMI2=OFF GGML_FMA=OFF GGML_F16C=OFF GGML_AVX_VNNI=OFF GGML_AVX512=OFF GGML_AVX512_VBMI=OFF GGML_AVX512_VNNI=OFF GGML_AVX512_BF16=OFF GGML_AMX_TILE=OFF GGML_AMX_INT8=OFF GGML_AMX_BF16=OFF"
      ;;
    *)
      echo "unsupported target profile '$1' (supported: ${SUPPORTED_TARGET_PROFILES})" >&2
      return 1 ;;
  esac
}

# The profile of THIS (native) host. An unsupported architecture leaves TARGET_PROFILE
# empty, and every build entry point then refuses to run (scripts/lib.sh). NOTE: no -flto
# on any profile — clang LTO emits LLVM bitcode objects, which a consumer linking the
# prebuilt .a with GNU ld / rustc's `cc` driver cannot consume (and rustc's LLVM version
# won't match clang 18's bitcode). LTO is incompatible with shipping native static archives.
TARGET_PROFILE=""
case "$(uname -m)" in
  aarch64|arm64) set_target_profile aarch64-graviton2 ;;
  x86_64|amd64)  set_target_profile x86_64-v3 ;;
esac

# llama-cpp-sys-2 cargo features to enable. NONE — and the crate is built with
# --no-default-features (scripts/lib.sh build_sys_crate), because its default set is
# ["common"]:
#  - no `openmp`: clang would pull LLVM libomp (absent on AL2023/Lambda); without it the
#    crate sets GGML_OPENMP=OFF and ggml uses its built-in pthread threadpool.
#  - no `common`: it builds llama.cpp's common/ library plus an extra llama_rs_* wrapper
#    archive and adds those decls to the generated bindings. We ship only the core
#    llama/ggml archives for direct FFI, so `common` would put unresolved-symbol risk on
#    consumers. (Before contract v4 it was silently ON via the default feature set.)
CRATE_FEATURES=""

# Canonical link ORDER (single source of truth). GNU ld resolves left-to-right, so a
# library must precede the libs it depends on: llama -> ggml -> ggml-cpu -> ggml-base.
# build.sh derives build-info.json's `link_line` from this, and scripts/consume.build.rs
# uses the SAME order. Keep all three in sync.
STATIC_LIBS="libllama.a libggml.a libggml-cpu.a libggml-base.a"

# System libraries a consumer must add at final link (documented in CONTRACT.md).
# No -lgomp: OpenMP is disabled (ggml threadpool).
SYSTEM_LINK_LIBS="stdc++ pthread m dl"

# --- PGO (profile-guided optimization) — opt-in via PGO=1 --------------------------
# Off by default: the normal build stays single-phase and needs no model. When PGO=1,
# build.sh does a 3-phase build (instrument -> train -> optimize): it builds an
# instrumented copy, runs the REAL embedding hot path (llama_encode, via scripts/pgo-train.cpp)
# to collect a profile, then feeds -fprofile-use into the shipped build. bench.sh (PGO=1)
# reuses the same profile to report the PGO gain plus an apples-to-apples parity check.
#
# The profile is QUANT-TYPE-SPECIFIC (each quant's dot/GEMM is a distinct function), so
# PGO_TRAIN_MODEL MUST be the quant you deploy (e.g. IQ4_NL). PGO changes codegen only —
# not the lib set / link line / features / binding ABI / dist layout — so it does NOT bump
# ARTIFACT_CONTRACT_VERSION; the profile is recorded (sha256) in build-info.json instead.
PGO="${PGO:-0}"
PGO_TRAIN_MODEL="${PGO_TRAIN_MODEL:-${SMOKE_MODEL:-}}"
PGO_TRAIN_ITERS="${PGO_TRAIN_ITERS:-300}"
# IR-PGO (NOT the frontend -fprofile-instr-*): better codegen, merged via llvm-profdata.
PGO_GEN_FLAGS="-fprofile-generate"
# -fprofile-use is completed with =<profdata> by build.sh once the profile exists. The
# -Wno-profile-* silence expected "changed / not profiled" notes for the (many) TUs the
# embedding-only training run never exercised.
PGO_USE_WARN_FLAGS="-Wno-profile-instr-unprofiled -Wno-profile-instr-out-of-date"

# Versioned artifact contract. Bump on ANY change to lib set, link line, features,
# binding ABI, dist/ layout, OR the guarantees a release carries.
#   v2: clang-18 compiler, dropped OpenMP (no -lgomp).
#   v3: added the numerical-correctness gate — a release now GUARANTEES the archives
#       produce embeddings within threshold of an independent generic-flags build and an
#       FP32 PyTorch golden (jina-embeddings-v5 via sentence-transformers), across
#       MEAN/LAST + NON_CAUSAL, single+batched, with determinism/batch/thread invariance.
#       build-info.json gains a `correctness` block.
#   v4: llama.cpp v0.6.0 (d8123504) via llama-cpp-rs 0.1.159 with the submodule pinned to
#       the tag; bindings.rs regenerated (new llama.h/ggml.h ABI) and built with
#       --no-default-features (no llama_rs_* items); build-info.json provenance
#       restructured (llama_cpp_rs / llama_cpp_sys_2 / llama_cpp blocks). Archive set and
#       link line unchanged. Second production variant x86_64-v3 (x86_64-unknown-linux-gnu,
#       -O3 -march=x86-64-v3, generic tuning) next to aarch64-graviton2; build-info.json
#       gains target_profile / architecture / host / pgo.architecture fields. (v4 was never
#       released; if it ever is published without x86, the x86 change must become v5.)
ARTIFACT_CONTRACT_VERSION="4"
