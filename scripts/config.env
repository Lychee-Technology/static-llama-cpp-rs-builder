# Single source of truth for pinned build inputs.
# Sourced by build.sh / package.sh / bench.sh. Changing any of these is a
# build-input change; bump ARTIFACT_CONTRACT_VERSION if it alters the output shape.

# Pinned build image (compiler baseline). AL2023 aarch64 pinned BY DIGEST so the
# compiler/glibc are a fully reproducible input (not a mutable tag). Bump deliberately:
#   docker manifest inspect amazonlinux:2023 | jq -r .config.digest   # or the index digest
# The resolved image is recorded verbatim in build-info.json (compiler.image).
AL2023_DIGEST="sha256:32f61af6a24e178e8142fb7b0079f4af3a5cda6816cd53d2c611a921ef029ca0"
COMPILER_IMAGE="amazonlinux:2023@${AL2023_DIGEST}"

# llama-cpp-rs (utilityai) pinned tag. The vendored llama.cpp submodule commit is
# whatever this tag references (resolved + recorded at build time).
CRATE_REPO="https://github.com/utilityai/llama-cpp-rs"
CRATE_TAG="0.1.151"

# Expected vendored llama.cpp submodule commit for CRATE_TAG (sanity-checked, not trusted).
EXPECTED_LLAMA_CPP_COMMIT="9e3b928fd8c9d14dbf15a8768b9fdd7e5c721d66"

# Cross/target profile. Graviton2 == Neoverse N1. Build ON N2 runners, so we MUST
# use an explicit -mcpu (never native) to avoid emitting N1-illegal instructions.
TARGET_TRIPLE="aarch64-unknown-linux-gnu"
CPU_MCPU="neoverse-n1"
CFLAGS_TUNE="-mcpu=${CPU_MCPU}"

# llama-cpp-sys-2 cargo features to enable.
CRATE_FEATURES="common,openmp"

# Canonical link ORDER (single source of truth). GNU ld resolves left-to-right, so a
# library must precede the libs it depends on: llama-common -> llama -> ggml ->
# ggml-cpu -> ggml-base. build.sh derives build-info.json's `link_line` from this, and
# scripts/consume.build.rs uses the SAME order. Keep all three in sync.
STATIC_LIBS="libllama-common.a libllama.a libggml.a libggml-cpu.a libggml-base.a"

# System libraries a consumer must add at final link (documented in CONTRACT.md).
SYSTEM_LINK_LIBS="stdc++ gomp pthread m dl"

# Versioned artifact contract. Bump on ANY change to lib set, link line, features,
# binding ABI, or dist/ layout.
ARTIFACT_CONTRACT_VERSION="1"
